#: inc/status.php:125
msgid "Search engines are blocked from indexing this site."
msgstr "Søgemaskiner er blokeret fra at indeksere dette website."

#: inc/status.php:134
msgid "Debug mode is on in production."
msgstr "Fejlfinding (debug) er slået til i produktion."

#. translators: %s: the detected environment name (e.g. "staging").
#: inc/status.php:145
msgid "This is the %s environment, not the live site."
msgstr "Dette er %s-miljøet, ikke det live website."

#: inc/status.php:154
msgid "No backups have been recorded for this site."
msgstr "Der er ikke registreret nogen backup for dette website."

#: inc/status.php:155
msgid "The most recent backup did not complete."
msgstr "Den seneste backup blev ikke gennemført."

#: inc/status.php:156
msgid "The most recent backup is older than expected."
msgstr "Den seneste backup er ældre end forventet."

#: inc/status.php:157
msgid "The most recent backup did not record whether it succeeded."
msgstr "Den seneste backup registrerede ikke, om den lykkedes."

#: inc/status.php:158
msgid "The most recent backup is dated in the future, so its age cannot be trusted."
msgstr "Den seneste backup er dateret i fremtiden, så dens alder ikke kan bruges."

#: inc/status.php:186
msgid "The MainWP security ID contains unsafe characters. Correct it in MainWP's own settings on this child site, then update the value stored on the Marginal dashboard to match."
msgstr "MainWP-sikkerheds-ID'et indeholder ugyldige tegn. Ret det i MainWP's egne indstillinger på dette child-site, og opdatér derefter værdien på Marginal-dashboardet, så de stemmer."

#: inc/status.php:187
msgid "The MainWP security ID contains unsafe characters and the site is disconnected. Correct it in MainWP's own settings on this child site, then update the value stored on the Marginal dashboard to match."
msgstr "MainWP-sikkerheds-ID'et indeholder ugyldige tegn, og websitet er ikke forbundet. Ret det i MainWP's egne indstillinger på dette child-site, og opdatér derefter værdien på Marginal-dashboardet, så de stemmer."

#: inc/status.php:196
msgid "WP_ENVIRONMENT_TYPE is not set, so this site reports as production whether it is or not."
msgstr "WP_ENVIRONMENT_TYPE er ikke angivet, så websitet rapporterer sig som produktion, uanset om det er det."

